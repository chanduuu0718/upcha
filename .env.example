# Upcha environment configuration
NODE_ENV=development
PORT=3001

# Cuelinks integration
# Create a Cuelinks API key with the write:links scope.
CUELINKS_API_KEY=
CUELINKS_SHORTEN_LINKS=true

# Pinterest integration (configure after Pinterest Trial access is approved)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Product/media settings
PRODUCT_SOURCE=myntra
MYNTRA_TIMEOUT_MS=12000
